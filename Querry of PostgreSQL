-- 1. Create Farmer Lots Table
CREATE TABLE IF NOT EXISTS farmer_lots (
    lot_id VARCHAR(50) PRIMARY KEY,
    farmer_name VARCHAR(100) NOT NULL,
    location VARCHAR(100) NOT NULL,
    lat DOUBLE PRECISION NOT NULL,
    lon DOUBLE PRECISION NOT NULL,
    crop VARCHAR(50) NOT NULL,
    quantity_tonnes DOUBLE PRECISION NOT NULL,
    grade VARCHAR(10) NOT NULL,
    expected_price DOUBLE PRECISION NOT NULL
);

-- 2. Create Buyer Demands Table
CREATE TABLE IF NOT EXISTS buyer_demands (
    buyer_id VARCHAR(50) PRIMARY KEY,
    buyer_type VARCHAR(100) NOT NULL,
    location VARCHAR(100) NOT NULL,
    lat DOUBLE PRECISION NOT NULL,
    lon DOUBLE PRECISION NOT NULL,
    req_crop VARCHAR(50) NOT NULL,
    req_quantity DOUBLE PRECISION NOT NULL,
    req_grade VARCHAR(10) NOT NULL,
    offered_price DOUBLE PRECISION NOT NULL,
    trust_score DOUBLE PRECISION NOT NULL
);

