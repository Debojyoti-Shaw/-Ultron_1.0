-- Remove duplicate rows based on crop and arrival_date
DELETE FROM agmarknet_mandi_prices a
USING agmarknet_mandi_prices b
WHERE a.id < b.id 
  AND a.crop = b.crop 
  AND a.arrival_date = b.arrival_date;
